# VITE_* values are embedded into the browser bundle at image build time.
# For a LAN deployment, VITE_SUPABASE_URL must be reachable by every client.
# SUPABASE_URL is used by the server-side app; it may use an internal Docker URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only credentials: never use a VITE_ prefix for these values.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
RESEND_API_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
